# OptiStock AI Configuration
# Copy this to .env and fill in your values

# LLM Model Configuration
OPENAI_API_KEY=your_openai_key_here
MODEL_NAME=gpt-4

# LangGraph / Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=optistock-ai

# Database
DATABASE_PATH=database/optistock.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_DEBUG_PROMPTS=false
MAX_AGENT_RETRIES=2

# Budget Configuration (in USD)
DEFAULT_MONTHLY_BUDGET=50000
DEFAULT_TARGET_COVER_DAYS=14

# Inventory Configuration (hours)
DATA_FRESHNESS_THRESHOLD=2

# Approval Configuration
APPROVAL_TIMEOUT_MINUTES=60
ENABLE_AUTO_APPROVAL=false  # Never auto-approve; require explicit human approval
